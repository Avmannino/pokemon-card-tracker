# Nothing else pulls prices, including the refresh buttons in the UI.
REFRESH_AM_TIME=08:00
REFRESH_PM_TIME=20:00

# pokemon-tcg-api on RapidAPI (graded eBay sold prices)
RAPIDAPI_KEY=rapidapi_key_REPLACE_ME
